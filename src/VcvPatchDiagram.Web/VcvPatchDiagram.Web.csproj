<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VcvPatchDiagram.Core\VcvPatchDiagram.Core.csproj" />
  </ItemGroup>

  <!-- One pan/zoom and one library preview script for both the static export and the app: copied from Core before each build. -->
  <Target Name="CopySharedScripts" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="..\VcvPatchDiagram.Core\Render\panzoom.js;..\VcvPatchDiagram.Core\Render\library.js" DestinationFolder="wwwroot\js" SkipUnchangedFiles="true" />
  </Target>

</Project>
